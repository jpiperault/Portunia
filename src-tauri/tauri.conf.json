{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Termoria",
  "version": "0.33.0",
  "identifier": "fr.termoria.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:release",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Termoria",
        "width": 1280,
        "height": 800,
        "minWidth": 820,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.png", "icons/icon.ico"],
    "publisher": "Termoria",
    "shortDescription": "Gestionnaire de sessions distantes",
    "longDescription": "SSH, Bureau à distance, VNC, Telnet, port série et consoles web dans une seule fenêtre.",
    "homepage": "https://github.com/jpiperault/Termoria-releases",
    "category": "Utility",
    "externalBin": ["binaries/termoria-rdp"],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French", "English"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERCRkMxMURBNTVEMTEyQzIKUldUQ0V0RlYyaEg4MjliQ3B6TnZzRGZIaDFLcGdJczNGclJIeS9tbkd4ZFVSMGppbHhBaHdNTEgK",
      "endpoints": ["https://github.com/jpiperault/Termoria-releases/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
